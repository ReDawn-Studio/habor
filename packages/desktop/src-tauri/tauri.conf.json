{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "habor",
  "version": "0.6.0",
  "identifier": "studio.redawn.habor",
  "build": {
    "beforeDevCommand": "pnpm --filter @agent-router/app-server build && npm run prepare:runtime && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @agent-router/app-server build && npm run prepare:runtime && npm run build",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "habor",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 700,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "runtime/": "runtime/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
